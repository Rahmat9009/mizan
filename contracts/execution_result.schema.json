{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mizan.dev/contracts/1.0.0/execution_result.schema.json",
  "title": "ExecutionResult",
  "description": "What happened at the gate and, if it got that far, at the broker.",
  "x-mizan-schema-version": "1.0.0",
  "x-mizan-generated-from": "mizan.contracts.execution_result.ExecutionResult",
  "$defs": {
    "BrokerRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "environment": {
          "title": "Environment",
          "type": "string",
          "enum": [
            "paper"
          ],
          "description": "Paper is the only representable environment. Live trading is a separate deployment and security boundary, not a value of this field (Hard Rule B1)."
        }
      },
      "required": [
        "name",
        "environment"
      ],
      "title": "BrokerRef",
      "type": "object"
    },
    "Fill": {
      "additionalProperties": false,
      "properties": {
        "filled_quantity": {
          "pattern": "^-?(0|[1-9]\\d*)(\\.\\d+)?$",
          "title": "Filled Quantity",
          "type": "string"
        },
        "avg_price": {
          "pattern": "^-?(0|[1-9]\\d*)(\\.\\d+)?$",
          "title": "Avg Price",
          "type": "string"
        },
        "filled_at": {
          "pattern": "^(\\d{4})-(\\d{2})-(\\d{2})[Tt](\\d{2}):(\\d{2}):(\\d{2})(?:\\.(\\d{1,9}))?([Zz]|[+-]\\d{2}:\\d{2})$",
          "title": "Filled At",
          "type": "string"
        }
      },
      "required": [
        "filled_quantity",
        "avg_price",
        "filled_at"
      ],
      "title": "Fill",
      "type": "object"
    },
    "ReasonCode": {
      "description": "Machine-readable reason codes from contracts/reason_codes.json (version REASON_CODE_VERSION).",
      "enum": [
        "ABSORBING_BARRIER_BREACHED",
        "ADVISORY_CLAMPED",
        "ADVISORY_INVALID_OUTPUT",
        "ADVISORY_REDUCE",
        "ADVISORY_REJECT",
        "ADVISORY_SKIPPED",
        "ADVISORY_UNAVAILABLE",
        "ADV_PARTICIPATION_EXCEEDED",
        "AGENT_DAILY_NOTIONAL_EXCEEDED",
        "AGENT_DAILY_ORDERS_EXCEEDED",
        "AGENT_OPEN_POSITIONS_EXCEEDED",
        "AGENT_OUTSIDE_ACTIVE_HOURS",
        "AGENT_STATE_MISSING",
        "AGENT_SYMBOL_NOT_ALLOWED",
        "AGGREGATE_EXPOSURE_EXCEEDED",
        "AGGREGATE_STATE_MISSING",
        "ASSET_NOT_TRADABLE",
        "ASSIGNMENT_RISK",
        "AUTHORIZATION_ALREADY_USED",
        "AUTHORIZATION_EXPIRED",
        "AUTHORIZATION_INVALID",
        "AUTHORIZATION_NOT_YET_VALID",
        "AUTHORIZATION_SCOPE_MISMATCH",
        "BOOK_LIQUIDATION_TIME_EXCEEDED",
        "BROKER_REJECTED",
        "BROKER_UNAVAILABLE",
        "BUYING_POWER_MISSING",
        "BUYING_POWER_UTILIZATION_EXCEEDED",
        "CALENDAR_MISSING",
        "CAPITAL_THRESHOLD_EXCEEDED",
        "CHAIN_INTEGRITY_FAILED",
        "CHECK_NOT_IMPLEMENTED",
        "CONCENTRATION_LIMIT_EXCEEDED",
        "CONFIDENCE_HAIRCUT_APPLIED",
        "CONSECUTIVE_LOSS_REVIEW",
        "CORRELATED_INTENT_DETECTED",
        "CROWDING_THRESHOLD_EXCEEDED",
        "DAYS_UNDER_WATER_EXCEEDED",
        "DRAWDOWN_LIMIT_BREACHED",
        "DTE_ABOVE_MAXIMUM",
        "DTE_BELOW_MINIMUM",
        "DUPLICATE_ORDER",
        "EARNINGS_BLACKOUT",
        "ENGINE_DEGRADED",
        "ENGINE_VERSION_MISMATCH",
        "ERRONEOUS_PRICE_DEVIATION",
        "ERRONEOUS_QUANTITY_DEVIATION",
        "ESTIMATED_IMPACT_EXCEEDED",
        "EXECUTION_DISABLED",
        "EXPECTED_SHORTFALL_EXCEEDED",
        "FACTOR_EXPOSURE_EXCEEDED",
        "GREEKS_MISSING",
        "HARD_REJECTION_UPHELD",
        "IDEMPOTENT_ORDER_EXISTS",
        "INSUFFICIENT_BUYING_POWER",
        "INVALIDATION_MISSING",
        "INVALID_PRICE",
        "INVALID_QUANTITY",
        "KILL_SWITCH_ACTIVE",
        "LEG_LIMIT_EXCEEDED",
        "LIQUIDITY_DATA_MISSING",
        "LIVE_TRADING_FORBIDDEN",
        "MACRO_EVENT_BLACKOUT",
        "MARKET_CLOSED",
        "MARKET_DATA_MISSING",
        "MARKET_DATA_STALE",
        "MODEL_PROVIDER_CONCENTRATION_EXCEEDED",
        "NAKED_SHORT_NOT_PERMITTED",
        "OPTIONS_DELTA_LIMIT_EXCEEDED",
        "OPTIONS_GAMMA_LIMIT_EXCEEDED",
        "OPTIONS_SHORT_GAMMA_LIMIT_EXCEEDED",
        "OPTIONS_SHORT_VEGA_LIMIT_EXCEEDED",
        "OPTIONS_VEGA_LIMIT_EXCEEDED",
        "OPTION_OPEN_INTEREST_TOO_LOW",
        "OPTION_SPREAD_TOO_WIDE",
        "OVERNIGHT_EXPOSURE_EXCEEDED",
        "PATH_STATE_MISSING",
        "PIN_RISK",
        "POLICY_HASH_MISMATCH",
        "POLICY_INVALID",
        "POLICY_NOT_FOUND",
        "PORTFOLIO_STATE_MISSING",
        "PORTFOLIO_STATE_STALE",
        "POSITION_LIMIT_EXCEEDED",
        "PRICE_MISSING",
        "PROPOSAL_EXPIRED",
        "REAUTHORIZATION_REQUIRED",
        "RECORD_NOT_FOUND",
        "RESPONSE_LEVEL_ESCALATED",
        "RESPONSE_LEVEL_HALT",
        "RESPONSE_LEVEL_RESTRICTS_NEW_RISK",
        "RESTRICTED_STRATEGY",
        "RESTRICTED_SYMBOL",
        "REWARD_RISK_BELOW_MINIMUM",
        "RISK_PER_TRADE_EXCEEDED",
        "SCHEMA_INVALID",
        "SECTOR_CONCENTRATION_EXCEEDED",
        "SECTOR_DATA_MISSING",
        "SESSION_WINDOW_RESTRICTED",
        "SIGNAL_SOURCE_CONCENTRATION_EXCEEDED",
        "SIZE_REDUCED_TO_POLICY_CAP",
        "SIZE_SCALED_BY_DRAWDOWN",
        "STATE_BINDING_MISMATCH",
        "STRESS_LOSS_EXCEEDED",
        "STRUCTURE_INVALID",
        "TENANT_ACCESS_DENIED",
        "TENANT_MISMATCH",
        "TOCTOU_STATE_CHANGED",
        "UNDEFINED_RISK_REQUIRES_APPROVAL",
        "UNKNOWN_FIELD",
        "UNSUPPORTED_ASSET_CLASS",
        "UNSUPPORTED_STRATEGY"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "RevalidationReport": {
      "additionalProperties": false,
      "description": "The TOCTOU re-check (E9). ``supported`` is False whenever the re-check did not run: unknown is not safe.",
      "properties": {
        "performed": {
          "title": "Performed",
          "type": "boolean"
        },
        "fresh_context_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fresh Context Id"
        },
        "fresh_evaluation_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fresh Evaluation Id"
        },
        "fresh_recommended_quantity": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9]\\d*)(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fresh Recommended Quantity"
        },
        "supported": {
          "title": "Supported",
          "type": "boolean"
        },
        "state_changed": {
          "default": false,
          "title": "State Changed",
          "type": "boolean"
        },
        "response_level_at_execution": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Level At Execution"
        }
      },
      "required": [
        "performed",
        "fresh_context_id",
        "fresh_evaluation_id",
        "fresh_recommended_quantity",
        "supported"
      ],
      "title": "RevalidationReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "result_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Result Id",
      "type": "string"
    },
    "auth_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Auth Id",
      "type": "string"
    },
    "decision_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Decision Id",
      "type": "string"
    },
    "proposal_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Id",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Tenant Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "SUBMITTED",
        "WOULD_SUBMIT",
        "BLOCKED",
        "FAILED",
        "RECONCILED_EXISTING"
      ],
      "title": "Status",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "$ref": "#/$defs/ReasonCode"
      },
      "title": "Reason Codes",
      "type": "array"
    },
    "broker": {
      "$ref": "#/$defs/BrokerRef"
    },
    "client_order_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Client Order Id"
    },
    "broker_order_id": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Broker Order Id"
    },
    "checked_at": {
      "pattern": "^(\\d{4})-(\\d{2})-(\\d{2})[Tt](\\d{2}):(\\d{2}):(\\d{2})(?:\\.(\\d{1,9}))?([Zz]|[+-]\\d{2}:\\d{2})$",
      "title": "Checked At",
      "type": "string"
    },
    "authorization_validated_at": {
      "anyOf": [
        {
          "pattern": "^(\\d{4})-(\\d{2})-(\\d{2})[Tt](\\d{2}):(\\d{2}):(\\d{2})(?:\\.(\\d{1,9}))?([Zz]|[+-]\\d{2}:\\d{2})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Authorization Validated At"
    },
    "kill_switch_checked_at": {
      "anyOf": [
        {
          "pattern": "^(\\d{4})-(\\d{2})-(\\d{2})[Tt](\\d{2}):(\\d{2}):(\\d{2})(?:\\.(\\d{1,9}))?([Zz]|[+-]\\d{2}:\\d{2})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Kill Switch Checked At"
    },
    "submitted_at": {
      "anyOf": [
        {
          "pattern": "^(\\d{4})-(\\d{2})-(\\d{2})[Tt](\\d{2}):(\\d{2}):(\\d{2})(?:\\.(\\d{1,9}))?([Zz]|[+-]\\d{2}:\\d{2})$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Submitted At"
    },
    "revalidation": {
      "$ref": "#/$defs/RevalidationReport"
    },
    "fills": {
      "items": {
        "$ref": "#/$defs/Fill"
      },
      "title": "Fills",
      "type": "array"
    },
    "broker_status": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Broker Status"
    },
    "message": {
      "maxLength": 4000,
      "title": "Message",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "auth_id",
    "decision_id",
    "proposal_id",
    "tenant_id",
    "status",
    "reason_codes",
    "broker",
    "client_order_id",
    "broker_order_id",
    "checked_at",
    "authorization_validated_at",
    "kill_switch_checked_at",
    "submitted_at",
    "revalidation",
    "broker_status",
    "message"
  ],
  "type": "object"
}
