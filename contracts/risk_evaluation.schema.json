              "type": "null"
            }
          ],
          "title": "Snapshot Ts"
        },
        "recommended_quantity": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9]\\d*)(\\.\\d+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recommended Quantity"
        },
        "detail": {
          "maxLength": 4000,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
