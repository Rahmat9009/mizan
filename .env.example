# =============================================================================
# Mizan — example environment. Copy to .env (gitignored) and fill in locally.
#
#   Placeholders only. Never put a real value in this file.
#   Empty means "unset": the process refuses to start or the feature stays off.
#
# There is NO live-trading mode in Mizan. ALPACA_PAPER must be "true"; any other
# value is refused at startup (Hard Rule B1) — it is a security boundary, not a
# feature flag.
# =============================================================================

# ----------------------------------------------------------------------------
# Mizan core (new: mizan/ package)
# ----------------------------------------------------------------------------

# Tenant this process serves. Pattern ^[a-z0-9][a-z0-9-]{0,62}$ (Hard Rule B3:
# one schema per tenant; the id selects the schema, it never filters queries).
MIZAN_TENANT_ID=tenant-a

# Default agent identity for the SDK when the caller does not supply one.
MIZAN_AGENT_ID=

# Versioned, hash-signed policy document loaded at startup.
MIZAN_POLICY_PATH=./policies/options-conservative.yaml

# Append-only hash-chained ledger root (one SQLite file per tenant). Gitignored.
MIZAN_LEDGER_DIR=./data/ledger

# Execution levels. Defaults submit zero orders:
#   MIZAN_EXECUTION_ENABLED=false  -> the execution adapter is never reached
#   MIZAN_EXECUTION_DRY_RUN=true   -> every gate runs, then WOULD_SUBMIT is returned
# Both must be flipped, deliberately, for a PAPER order to be submitted.
MIZAN_EXECUTION_ENABLED=false
MIZAN_EXECUTION_DRY_RUN=true

# Kill switch. Read from the environment on EVERY call, immediately before the
# broker mutation (Hard Rule E4). true blocks all new execution.
MIZAN_KILL_SWITCH=false

# API bearer tokens, "agent_id:token,agent_id:token". Tokens are generated
# (e.g. python -c "import secrets;print(secrets.token_urlsafe(32))") and are
# never committed. Empty disables the HTTP API's authenticated routes.
MIZAN_API_TOKENS=

# Allowed browser origins for the console (comma-separated; wildcards refused).
MIZAN_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------------------------------------------------------
# Broker — Alpaca PAPER only
# ----------------------------------------------------------------------------

# Paper-account keys live in the customer's environment, never in Mizan (B2).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Must be "true". Any other value is refused at startup; there is no live mode.
ALPACA_PAPER=true

# ----------------------------------------------------------------------------
# Postgres (docker-compose.yml / infra/postgres). Per-tenant schema isolation.
# ----------------------------------------------------------------------------

POSTGRES_USER=mizan
# Required. docker compose refuses to start without it (no default, ever).
POSTGRES_PASSWORD=
POSTGRES_DB=mizan

# Application connection string. Leave empty to use the SQLite ledger.
#   DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/mizan?sslmode=require
# sslmode=require (or verify-full) is the production setting. The local compose
# Postgres does not terminate TLS yet (see docker-compose.yml TODO) and is bound
# to 127.0.0.1 only; use sslmode=prefer for local development.
DATABASE_URL=

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------

LOG_LEVEL=INFO

# ============================================================================
# Legacy app/ (Rahmat's portfolio governor) — kept for its tests and demos.
# Same defaults as before. New code reads the MIZAN_* variables above.
# ============================================================================

# Optional Anthropic provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Primary live contextual risk provider.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_DEBUG=false
FEATHERLESS_ENABLE_THINKING=false

# Controlled paper execution. These defaults submit zero orders.
ALPACA_EXECUTION_ENABLED=false
ALPACA_EXECUTION_DRY_RUN=true
ALPACA_EXECUTION_KILL_SWITCH=false
EXECUTION_MAX_DECISION_AGE_SECONDS=120

# Optional one-share paper-execution demo input.
DEMO_SYMBOL=AAPL
DEMO_ESTIMATED_PRICE=250.00
DEMO_PROPOSAL_ID=demo-full-lifecycle-aapl-buy-1
DEMO_STRATEGY_CONFIDENCE=0.82
# Manual demo inputs; these are not presented as live market data.
DEMO_ANNUALIZED_VOLATILITY=0.30
DEMO_MAX_DRAWDOWN_30D=0.10
DEMO_LIQUIDITY_SCORE=0.95

# Durable local state. Parent directories are created automatically.
APP_DB_PATH=./data/portfolio_governor.db

# Local frontend origins (comma-separated; JSON array syntax is also accepted).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Bounded read-only broker reconciliation after a PAPER submission.
ORDER_RECONCILE_TIMEOUT_SECONDS=30
ORDER_RECONCILE_INTERVAL_SECONDS=2
