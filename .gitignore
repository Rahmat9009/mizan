# --- secrets and local environment (never commit) ---
.env
.env.*
!.env.example

# --- virtual environments ---
.venv/
.venv-new/
.venv-broken-*/
venv/

# --- python build / caches ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
dist/
build/
*.egg-info/

# --- git worktrees used by parallel lanes ---
.worktrees/

# --- runtime state: ledgers, databases, audit dumps ---
data/
# The frontend's TypeScript fixtures are application source, not runtime state.
!/web/src/data/
!/web/src/data/**
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-wal
*.sqlite-shm
audit*.json

# --- editor / OS noise ---
.idea/
.vscode/
.DS_Store
Thumbs.db
.mizan-orchestrator.lock
# Scratch by default - but NOT the shipped proof. A reproducibility claim whose artifacts are
# gitignored is not reproducible: on a fresh clone the command in the writeup had no ledger to read.
# Excluding the CONTENTS rather than the directory, because git will not descend into an excluded
# directory and so can never re-include anything inside one.
/evidence/*
!/evidence/live-ledger/
# *.sqlite above still matches the file itself; last matching pattern wins, so re-include it here.
!/evidence/live-ledger/*.sqlite
!/evidence/pack/
!/evidence/demo-transcript.txt
!/evidence/ev-backtest/
